#!/bin/bash

exec > >(tee /tmp/solve-challenge-4.log) 2>&1
set -euxo pipefail

# Step 1 (learner: Create > Outbound Host > ToEmail, Enable Now): add ToEmail to the production.
# iris session cannot run multiline blocks, so the logic lives in a class loaded from /tmp.
cat > /tmp/SolveChallenge4.cls <<'EOCLS'
Class HoleFoods.Interop.SolveChallenge4
{

ClassMethod AddToEmail() As %Status
{
    set tSC = $$$OK
    try {
        set production = ##class(Ens.Config.Production).%OpenId("HoleFoods.Interop.Production")
        set alreadyPresent = 0
        for i = 1:1:production.Items.Count() {
            if production.Items.GetAt(i).Name = "ToEmail" set alreadyPresent = 1
        }

        if alreadyPresent {
            write "ToEmail already in production, enabling it",!
            set tSC = ##class(Ens.Director).EnableConfigItem("ToEmail", 1, 1)
            quit
        }

        set item = ##class(Ens.Config.Item).%New()
        set item.Name = "ToEmail"
        set item.ClassName = "HoleFoods.Interop.BO.ToEmail"
        set item.PoolSize = 1
        set item.Enabled = 1
        do production.Items.Insert(item)

        set tSC = production.%Save()
        quit:$$$ISERR(tSC)

        set tSC = ##class(Ens.Director).UpdateProduction()
        quit:$$$ISERR(tSC)
        write "ToEmail added and production updated.",!
    } catch ex {
        set tSC = ex.AsStatus()
    }
    quit tSC
}

}
EOCLS
chmod a+r /tmp/SolveChallenge4.cls

su - irisowner <<'EOSU'
cat <<'EOF' | iris session iris -UUSER
do $system.OBJ.Import("/tmp/SolveChallenge4.cls", "ck")
set sc = ##class(HoleFoods.Interop.SolveChallenge4).AddToEmail()
if $system.Status.IsError(sc) write "SOLVE ERROR: " do $system.Status.DisplayError(sc)
halt
EOF
EOSU

# Step 2 (learner: submit an order in the Shop tab): same REST call the web form makes.
# Fails loudly unless the order is accepted AND ToEmail sent the confirmation.
python3 - <<'PYEOF'
import json
import urllib.request

base = "http://localhost:52773/api/holeFoods"

with urllib.request.urlopen(base + "/outlets") as resp:
    first_outlet = json.load(resp)[0]

order = {
    "SKU": "SKU-976",
    "Quantity": 1,
    "Email": "customer@example.com",
    "City": first_outlet["city"],
    "OutletId": first_outlet["id"],
}
request = urllib.request.Request(
    base + "/order",
    data=json.dumps(order).encode(),
    headers={"Content-Type": "application/json"},
    method="POST",
)
with urllib.request.urlopen(request) as resp:
    result = json.load(resp)

print("Order response:", result)
if result["status"] != "success":
    raise SystemExit("Order failed: %s" % result)
if result["emailSent"] is not True:
    raise SystemExit("Order placed but ToEmail did not send: %s" % result)
PYEOF

